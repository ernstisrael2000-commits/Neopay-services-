# ── Firebase Admin (OBLIGATOIRE) ──────────────────────────────────────────────
# JSON du compte de service Firebase — depuis Firebase Console
# > Project Settings > Service Accounts > Generate New Private Key
# Peut être fourni tel quel (JSON brut) ou encodé en base64
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ── Email SMTP — Gmail (OPTIONNEL) ────────────────────────────────────────────
# Adresse Gmail utilisée pour les notifications administrateur
SMTP_USER=votre-email@gmail.com
# Mot de passe d'application Gmail (pas votre mot de passe principal)
# Générer depuis : Compte Google > Sécurité > Mots de passe des applications
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# ── Google reCAPTCHA v2 (OPTIONNEL) ──────────────────────────────────────────
# Clé secrète depuis : https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=6Le...
# Clé publique pour le frontend (exposée dans Vite via vite.config.ts)
RECAPTCHA_SITE_KEY=6Le...

# ── Paym Plop Plop (OBLIGATOIRE pour les paiements automatiques de formations) ─
# Identifiant marchand fourni par Paym Plop Plop
PLOPPLOP_CLIENT_ID=votre-client-id

# ── Push Notifications VAPID (OPTIONNEL) ──────────────────────────────────────
# Générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BJbF5eX...
VAPID_PRIVATE_KEY=abc123...

# ── Serveur (OPTIONNEL) ───────────────────────────────────────────────────────
# Port d'écoute (défaut: 5000 en dev, injecté automatiquement sur Railway/Render)
PORT=5000

# ── URL de l'application (OBLIGATOIRE en production) ──────────────────────────
# Doit correspondre exactement (protocole + domaine, sans slash final) au domaine
# public de déploiement. Utilisée pour la politique CORS et les liens dans les
# emails. Sur Vercel, VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL sont aussi
# autorisés automatiquement (voir api/index.ts) mais APP_URL reste nécessaire
# pour server.ts (Replit/Railway/Render/Docker) et pour un domaine personnalisé.
APP_URL=https://votredomaine.com

# ── Redis / Upstash (OPTIONNEL mais recommandé sur Vercel) ────────────────────
# Sans REDIS_URL, les notifications temps réel (SSE) utilisent un bus en mémoire
# qui ne fonctionne que sur un seul processus. Sur Vercel (plusieurs instances
# serverless), un événement publié par une instance ne serait jamais reçu par
# une connexion SSE ouverte sur une autre instance. Fournir une URL Redis
# (ex: Upstash) active un bus pub/sub partagé entre toutes les instances.
REDIS_URL=rediss://default:password@your-instance.upstash.io:6379
